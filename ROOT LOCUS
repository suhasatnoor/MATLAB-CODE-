%% MATLAB Script: Root Locus Plot
% System: G(s)H(s) = (s - 2) / (s^2 + 2s + 2)

clear; clc; close all;

% Define the Transfer Function
num = [1 -2];       % s - 2
den = [1 2 2];      % s^2 + 2s + 2
sys = tf(num, den);

% Configure Plot Environment
figure('Name', 'Root Locus Analysis', 'NumberTitle', 'off');
set(0, 'DefaultLineLineWidth', 2);

% Generate Root Locus
rlocus(sys);
title('Root Locus: Bending Inward into the Right-Half Plane', 'FontSize', 12);
grid on;
