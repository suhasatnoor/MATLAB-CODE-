%% MATLAB Script: Nyquist Diagram
% System: G(s)H(s) = (s - 2) / (s^2 + 2s + 2)

clear; clc; close all;

% Define the Transfer Function
num = [1 -2];       % s - 2
den = [1 2 2];      % s^2 + 2s + 2
sys = tf(num, den);

% Configure Plot Environment
figure('Name', 'Nyquist Stability Analysis', 'NumberTitle', 'off');
set(0, 'DefaultLineLineWidth', 2);

% Generate Nyquist Diagram
nyquist(sys);
title('Nyquist Plot: Counter-Intuitive Encirclement Configuration', 'FontSize', 12);
grid on;
